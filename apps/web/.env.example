# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth identity database. Use a dedicated auth schema / database role.
AUTH_DATABASE_URL=postgresql://org_auth:change-me@localhost:5432/org_os?options=-c%20search_path%3Dauth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# Domain application database. Use a role that cannot alter auth schema.
DATABASE_URL=postgresql://org_app:change-me@localhost:5432/org_os?options=-c%20search_path%3Dapp,public

# HMAC key used to pseudonymize abuse-control identifiers. Rotate through a controlled migration, never commit a real value.
PRIVACY_HASH_SECRET=replace-with-at-least-32-random-bytes

# Public signup must remain false until invitation/application onboarding and email verification are production-ready.
ALLOW_PUBLIC_SIGNUP=false

# Break-glass access is provisioned outside normal UI and must never be committed.
BREAK_GLASS_PRINCIPAL=

# Deployment
APP_ENV=development
