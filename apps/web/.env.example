# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth identity database. Use a dedicated auth schema / database role.
AUTH_DATABASE_URL=postgresql://org_auth:change-me@localhost:5432/org_os?options=-c%20search_path%3Dauth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# Domain application database. Use a role that cannot alter auth schema.
DATABASE_URL=postgresql://org_app:change-me@localhost:5432/org_os?options=-c%20search_path%3Dapp,public

# HMAC key used to pseudonymize abuse-control identifiers. Rotate through a controlled migration, never commit a real value.
PRIVACY_HASH_SECRET=replace-with-at-least-32-random-bytes

# Launch gates default closed.
ALLOW_PUBLIC_SIGNUP=false
APPLICATION_INTAKE_ENABLED=false

# One-time emergency Org authority bootstrap. Leave blank normally.
# Valid formats: user:<exact-better-auth-user-id> or email:<exact-email>.
# A matching principal must enroll 2FA first. The first successful bootstrap creates one 60-minute break-glass assignment;
# any historical break-glass assignment permanently prevents environment bootstrap from silently granting it again.
# Remove/rotate this value immediately after recovery. Never commit a real principal.
BREAK_GLASS_PRINCIPAL=

# Deployment
APP_ENV=development
